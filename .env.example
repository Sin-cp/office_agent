# Compose variables. This file contains no secrets.
# Keep loopback binding for personal testing via an SSH tunnel.
OFFICE_AGENT_BIND_IP=127.0.0.1
OFFICE_AGENT_HTTP_PORT=8080
# On ECS, use /srv/office-agent/data (create it with owner UID/GID 10001).
OFFICE_AGENT_HOST_DATA_DIR=./deploy-data

# Fill the real key only in ignored .env. Never use a VITE_ variable for secrets.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web search/fetch use the official endpoint by default; blank key reuses DEEPSEEK_API_KEY.
DEEPSEEK_WEB_BASE_URL=https://api.deepseek.com
DEEPSEEK_WEB_API_KEY=
OFFICE_AGENT_TIMEZONE=Asia/Shanghai
